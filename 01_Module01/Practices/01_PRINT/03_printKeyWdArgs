print("#normal print statements")
print("Hello buddy.")
print("How are you?")

print()
print("#print statement with KEYWORD ARGUMENTS - empty 'end'")
print("Hello buddy.", end = " ")
print("How are you?")

print()
print("#print statement with KEYWORD ARGUMENTS - \\n 'end'")
print("Hello buddy.", end = "\n")
print("How are you?")

print()
print("#print statement with KEYWORD ARGUMENTS - sep")
print("Hello buddy.", "I am fine.", "How are you?", sep="-")

print()
print("#print statement with KEYWORD ARGUMENTS - sep & end")
print("Hello buddy.", "I am fine.", "How are you?", sep="-", end="*")
print("Hello buddy.", "I am fine.", "How are you?", sep="\n", end="*")

